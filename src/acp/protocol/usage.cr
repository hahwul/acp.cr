require "./raw_json"

module ACP
  module Protocol
    # Draft token counts reported with a v1 prompt result or v2 idle state.
    struct Usage
      include JSON::Serializable
      include LosslessMetadata

      # :nodoc:
      module OptionalCount
        def self.from_json(pull : JSON::PullParser) : UInt64?
          return pull.read_raw.to_u64? if pull.kind.int?

          pull.skip
          nil
        end

        def self.to_json(value : UInt64, json : JSON::Builder) : Nil
          json.number(value)
        end
      end

      # :nodoc:
      module Optional
        def self.from_json(pull : JSON::PullParser) : Usage?
          from_json(WireFrame.read_raw(pull))
        end

        def self.from_json(json : String) : Usage?
          Usage.from_json(json) if json.starts_with?('{')
        rescue JSON::ParseException
          nil
        end

        def self.to_json(value : Usage, json : JSON::Builder) : Nil
          value.to_json(json)
        end
      end

      # Reported total across all token types.
      @[JSON::Field(key: "totalTokens")]
      property total_tokens : UInt64

      # Tokens supplied to the model.
      @[JSON::Field(key: "inputTokens")]
      property input_tokens : UInt64

      # Tokens generated by the model.
      @[JSON::Field(key: "outputTokens")]
      property output_tokens : UInt64

      # Reasoning tokens, when reported.
      @[JSON::Field(key: "thoughtTokens", converter: ::ACP::Protocol::Usage::OptionalCount)]
      property thought_tokens : UInt64?

      # Tokens read from the cache, when reported.
      @[JSON::Field(key: "cachedReadTokens", converter: ::ACP::Protocol::Usage::OptionalCount)]
      property cached_read_tokens : UInt64?

      # Tokens written to the cache, when reported.
      @[JSON::Field(key: "cachedWriteTokens", converter: ::ACP::Protocol::Usage::OptionalCount)]
      property cached_write_tokens : UInt64?

      # Builds a usage report with optional reasoning and cache counts.
      def initialize(@total_tokens : UInt64, @input_tokens : UInt64, @output_tokens : UInt64, *,
                     @thought_tokens : UInt64? = nil, @cached_read_tokens : UInt64? = nil,
                     @cached_write_tokens : UInt64? = nil, meta : Hash(String, JSON::Any)? = nil)
        self.meta = meta
      end
    end
  end
end
